<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- sink forks a PTY and execs the user's login shell. The App Sandbox
         forbids both, so sink cannot be sandboxed. Stated explicitly rather
         than omitted so the intent is on the record. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
