# Escape-sequence fragments for libFuzzer to splice into inputs (-dict=).
# A fuzzer finds a 4-byte magic sequence by chance only rarely; given these,
# it combines them from the start.
esc="\x1b"
csi="\x1b["
osc="\x1b]"
dcs="\x1bP"
apc="\x1b_"
pm="\x1b^"
sos="\x1bX"
st="\x1b\\"
bel="\x07"
csi_priv="\x1b[?"
csi_gt="\x1b[>"
csi_lt="\x1b[<"
csi_eq="\x1b[="
semi=";"
colon=":"
sgr="m"
sgr_rgb="38;2;"
sgr_256="38;5;"
alt_screen="?1049h"
alt_screen_off="?1049l"
paste_on="?2004h"
sync="?2026h"
decckm="?1h"
mouse_sgr="?1006h"
decrqm="$p"
decstr="!p"
decscusr=" q"
xtwinops="14t"
rep="b"
ed="J"
el="K"
osc_title="0;"
osc_cwd="7;file://"
osc_link="8;;"
osc_clip="52;c;"
osc_query="?"
osc_color="4;"
osc_fg="10;"
osc_bg="11;"
osc_mark_a="133;A"
osc_mark_b="133;B"
osc_mark_c="133;C"
rgb="rgb:"
hash_color="#"
kitty_g="\x1b_G"
kitty_transmit="a=T,"
kitty_place="a=p,"
kitty_delete="a=d,"
kitty_query="a=q,"
kitty_png="f=100,"
kitty_rgb="f=24,"
kitty_rgba="f=32,"
kitty_more="m=1;"
