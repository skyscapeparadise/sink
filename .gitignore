# CMake Build Artifacts
build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
sink.app/

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Icon design source & temporary assets
icon.iconset/
icon.psd

# Release scripts. signapp.sh, makedmg.sh and updatepassword.sh stay out of
# the repo (notarization credentials); package.sh and the entitlements plist
# carry no secrets and are tracked. Note the releases/* form -- a bare
# "releases/" makes git skip the directory entirely and the negations below
# would never be considered.
releases/*
!releases/package.sh
!releases/sink.entitlements

# Rust build artifacts (bench/vte_bench)
bench/vte_bench/target/

# Vendored dependencies (built by vendor/build_*.sh; each pins a version and
# verifies a checksum, so these are reproducible rather than committed)
vendor/ffmpeg/
vendor/.cache/
vendor/.build/
vendor/sdl3_image/
vendor/textstack/

# Generated benchmark workloads (~32MB, recreate with bench/gen_workloads.py)
bench/workloads/

# Packaged release artifacts
*.dmg
*.zip
